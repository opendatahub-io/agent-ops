# Copy to .env. Never commit .env. Deployment tooling must create Secrets
# for secret values; do not put them in image layers or client-side variables.
# Run python3 scripts/init_env.py to initialize .env and internal secrets.
# Some image/namespace defaults are fixed by deployment manifests; see docs/deployment.md.

# Configure your own Anthropic Messages-compatible endpoint with tool calling.
# Replace the example URL and model ID; no model service is selected by default.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://llm.example.com
ANTHROPIC_MODEL=your-model-id
# Optional: disabled sends thinking={type: disabled}, only for endpoints supporting it.
# default leaves the provider's behavior unchanged.
ANTHROPIC_THINKING_MODE=default
# Optional PEM CA bundle path if the model service requires a private CA.
MODEL_CA_BUNDLE=

# Use the current oc login; do not copy its token into this file.
OPENSHIFT_CONTEXT=
APP_NAMESPACE=red-compass
OPENSHELL_NAMESPACE=openshell
TARGET_ARCH=amd64

# OpenShell image references are declared in deploy/openshell-values.yaml and deploy/dashboard.yaml.
# Filled by deployment after application image builds. The sandbox runtime
# image above is separate from the Python agent workload image below.
AGENT_IMAGE=
API_IMAGE=
WEB_IMAGE=

# Infrastructure values resolved/generated during deployment, not user prerequisites.
OPENSHELL_GATEWAY_URL=
API_BASE_URL=
DATABASE_URL=
# Generated by scripts/init_env.py; preserve the password when reusing a database PVC.
DATABASE_PASSWORD=
SESSION_SECRET=
AGENT_TOKEN_SIGNING_SECRET=

# Review settings. Ticket/attempt IDs and scoped credentials are supplied
# separately for each sandbox, never shared through this file.
AGENT_MAX_TURNS=30
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_TOOLS_PER_TURN=8
MAX_CONCURRENT_REVIEWS=2
MAX_REVIEW_RETRIES=1
SANDBOX_RETENTION_SECONDS=600

# Bake this model into the API image for CPU-only, offline embedding queries.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
POLICY_VERSION=demo-2026-01


# Optional local tracing; the OpenShift launcher configures its internal service.
# Leave blank locally to disable tracing. No model prompts or applicant text are exported.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=red-compass-reviews
