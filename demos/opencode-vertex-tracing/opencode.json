{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@mlflow/opencode"],
  "provider": {
    "google-vertex": {
      "options": {
        "location": "us-east5"
      }
    }
  },
  "model": "google-vertex/claude-opus-4-6",
  "mcp": {
    "jira": {
      "type": "local",
      "command": ["uv", "tool", "run", "mcp-atlassian"],
      "enabled": true
    }
  }
}
