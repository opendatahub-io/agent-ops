        <mxCell id="e2" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#CC4444;exitX=1;exitY=0.5;entryX=0;entryY=0.73;" edge="1" parent="1" source="cli" target="gw">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="500"/><mxPoint x="255" y="465"/><mxPoint x="610" y="465"/><mxPoint x="610" y="410"/></Array></mxGeometry>
        </mxCell>
