<mxfile host="drawio">
  <diagram id="setup" name="OpenShell on OpenShift setup">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="-30" y="-40" width="1430" height="960" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;OpenShell with OpenShift AI: what agent-ops sets up&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#151515;" vertex="1" parent="1">
          <mxGeometry x="20" y="-30" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- people and tools outside the cluster -->
        <mxCell id="admin" value="&lt;b&gt;Platform admin&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;make deploy · user-auth · token-exchange&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sync" value="&lt;b&gt;Member sync ②&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;make grant · revoke · sync-members&lt;br&gt;Keycloak groups → workspaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#CC4444;dashed=1;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;User · browser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;signs in with Keycloak&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="355" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;User · openshell CLI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;browser or device-code login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Step badges = install guides&lt;/b&gt;&lt;br&gt;① install/01-install&lt;br&gt;② install/02-user-auth&lt;br&gt;③ install/03-agent-identity&lt;br&gt;④ install/04-agent-images&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#CC4444&quot;&gt;red&lt;/font&gt;: request path · &lt;font color=&quot;#CC4444&quot;&gt;dashed&lt;/font&gt;: identity calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D0D0D0;fontColor=#4D4D4D;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="640" width="210" height="150" as="geometry"/>
        </mxCell>

        <!-- cluster -->
        <mxCell id="cluster" value="OpenShift 4.19+ cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D0D0D0;fontColor=#6A6A6A;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="1100" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="op1" value="&lt;b&gt;Red Hat build of Agent Sandbox ①&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;operator · Sandbox CRD (v1beta1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="60" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="op2" value="&lt;b&gt;Zero Trust Workload Identity Manager ③&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;SPIRE server · agents · CSI driver · OIDC discovery&lt;br&gt;one SPIFFE ID per sandbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="op3" value="&lt;b&gt;Product images ①&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;quay.io/opendatahub/odh-openshell-*:v0.1.2-rhaiv.5&lt;br&gt;Helm chart 0.0.0-dev.e7fdd6b&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="60" width="340" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ns" value="namespace openshell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;dashed=1;fontColor=#6A6A6A;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="1060" height="680" as="geometry"/>
        </mxCell>

        <mxCell id="dash" value="&lt;b&gt;Dashboard ②&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4D4D4D&quot;&gt;oauth2-proxy → dashboard (loopback)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;role gate · NetworkPolicy: router only&lt;br&gt;Route (edge TLS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#CC4444;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="310" y="330" width="270" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;OpenShell gateway ①&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4D4D4D&quot;&gt;control plane API · sandbox lifecycle&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;OIDC on, no anonymous access ②&lt;br&gt;SPIFFE token grants ③ · Route (passthrough)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#CC4444;strokeWidth=2;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="kc" value="&lt;b&gt;Red Hat build of Keycloak ②③&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4D4D4D&quot;&gt;one HTTPS issuer (Route) for everyone&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;per gateway: API client, roles admin · user&lt;br&gt;groups → roles · CLI, dashboard, automation clients&lt;br&gt;SPIFFE identity provider (trusts SPIRE)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="reg" value="&lt;b&gt;keycloak-registrar interceptor ③&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;registers each sandbox's SPIFFE ID as a client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="520" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Your API ③&lt;/b&gt; &lt;font color=&quot;#6A6A6A&quot;&gt;(demo: whoami-api)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;verifies the Keycloak token: user + sandbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="700" width="320" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="sbx" value="Sandbox (Agent Sandbox CR) ①" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CC4444;dashed=1;fontColor=#A60000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="310" y="560" width="620" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="sup" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4D4D4D&quot;&gt;policy · egress proxy · credentials&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;token exchange hop 2 ③&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="610" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="wl" value="&lt;b&gt;Agent workload ④&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4D4D4D&quot;&gt;your image (ubi9/ubi-minimal base)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;holds no credentials · runtime injected&lt;br&gt;by an init container&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="610" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;SPIRE agent (CSI socket) ③&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A6A6A&quot;&gt;issues the sandbox's JWT-SVID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;dashed=1;fontColor=#151515;fontSize=11;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="740" width="270" height="70" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e0" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#6A6A6A;exitX=1;exitY=0.5;entryX=0;entryY=0.13;" edge="1" parent="1" source="admin" target="cluster">
          <mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry>
